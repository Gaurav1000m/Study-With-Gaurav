<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressDrawable="@drawable/progress_bar_drawable"
        android:visibility="gone" />

    <!-- VPN BLOCK OVERLAY -->
    <LinearLayout
        android:id="@+id/vpnBlockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA090D16"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚫"
            android:textSize="54sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/vpn_detected_title"
            android:textColor="@color/danger"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/vpn_detected_desc"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRetryVpn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/danger"
            android:text="@string/btn_retry"
            android:textColor="@color/text_light"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- PRIVATE DNS & AD BLOCK OVERLAY -->
    <LinearLayout
        android:id="@+id/dnsBlockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA090D16"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="54sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dns_detected_title"
            android:textColor="@color/warning"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/dns_detected_desc"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRetryDns"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/warning"
            android:text="@string/btn_retry"
            android:textColor="@color/background_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenDnsSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#334155"
            android:text="@string/btn_open_settings"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
